[
 {
  "doctype": "Custom Field",
  "dt": "HD Settings",
  "fieldname": "facility_visit_scheduling_section",
  "fieldtype": "Section Break",
  "label": "Facility Visit Scheduling",
  "insert_after": "sla_breach_reminder_template",
  "description": "Controls the room-visit slot students can request on Facilities tickets raised from the Student Portal.",
  "name": "HD Settings-facility_visit_scheduling_section"
 },
 {
  "doctype": "Custom Field",
  "dt": "HD Settings",
  "fieldname": "facility_visit_hours_start",
  "fieldtype": "Time",
  "label": "Visit Hours Start",
  "insert_after": "facility_visit_scheduling_section",
  "default": "09:00:00",
  "reqd": 1,
  "name": "HD Settings-facility_visit_hours_start"
 },
 {
  "doctype": "Custom Field",
  "dt": "HD Settings",
  "fieldname": "facility_visit_column_break",
  "fieldtype": "Column Break",
  "insert_after": "facility_visit_hours_start",
  "name": "HD Settings-facility_visit_column_break"
 },
 {
  "doctype": "Custom Field",
  "dt": "HD Settings",
  "fieldname": "facility_visit_hours_end",
  "fieldtype": "Time",
  "label": "Visit Hours End",
  "insert_after": "facility_visit_column_break",
  "default": "20:00:00",
  "reqd": 1,
  "name": "HD Settings-facility_visit_hours_end"
 },
 {
  "doctype": "Custom Field",
  "dt": "HD Settings",
  "fieldname": "facility_visit_window_hours",
  "fieldtype": "Int",
  "label": "Max Advance Booking Window (Hours)",
  "insert_after": "facility_visit_hours_end",
  "default": "24",
  "reqd": 1,
  "description": "Students must pick a visit date/time within this many hours from ticket creation.",
  "name": "HD Settings-facility_visit_window_hours"
 }
]
